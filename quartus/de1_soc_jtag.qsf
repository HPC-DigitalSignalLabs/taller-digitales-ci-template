# SPDX-License-Identifier: Apache-2.0
# Opt-in profile. Native station only; physical board revision must be checked.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY de1_soc_jtag_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name SEED 1
set_global_assignment -name SDC_FILE quartus/targets/de1_soc_jtag.sdc
set_global_assignment -name SYSTEMVERILOG_FILE src/counter.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/wr_decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/jtag_counter.sv
set_global_assignment -name SYSTEMVERILOG_FILE quartus/boards/de1_soc_jtag_top.sv
set_global_assignment -name QIP_FILE quartus/ip/jtag_uart_system/synthesis/jtag_uart_system.qip

# Same DE1-SoC pin assignments as the maintained panel project, reduced to the
# clock, reset key and LEDs. No HPS, GPIO, memory or seven-segment pins are used.
set_location_assignment PIN_AF14 -to CLOCK_50
set_location_assignment PIN_AA14 -to KEY0_N
set_location_assignment PIN_V16 -to LEDR[0]
set_location_assignment PIN_W16 -to LEDR[1]
set_location_assignment PIN_V17 -to LEDR[2]
set_location_assignment PIN_V18 -to LEDR[3]
set_location_assignment PIN_W17 -to LEDR[4]
set_location_assignment PIN_W19 -to LEDR[5]
set_location_assignment PIN_Y19 -to LEDR[6]
set_location_assignment PIN_W20 -to LEDR[7]
set_location_assignment PIN_W21 -to LEDR[8]
set_location_assignment PIN_Y21 -to LEDR[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY0_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR[*]
# Explicitly preserve the fitted Quartus defaults; still subject to PCB review.
set_instance_assignment -name CURRENT_STRENGTH_NEW "16MA" -to LEDR[*]
set_instance_assignment -name SLEW_RATE 1 -to LEDR[*]
